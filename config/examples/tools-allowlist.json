{
  "_comment": "Curated RayBridge allowlist. Enable only the Raycast extensions and tools you want exposed.",
  "mode": "allowlist",
  "raycastApi": {
    "enableLocalStorage": true,
    "enableClipboard": true,
    "enableSystemActions": true,
    "enableDestructiveSystemActions": false,
    "enableAppleScript": false,
    "enableCommandLaunch": false
  },
  "extensions": {
    "github": {
      "enabled": true,
      "tools": [
        "get-notifications",
        "search-issues",
        "search-pull-requests",
        "search-repositories",
        "merge-pull-request",
        "close-issue",
        "reopen-issue",
        "list-workflow-runs",
        "run-workflow"
      ]
    },
    "github-copilot": {
      "enabled": true,
      "tools": ["create-task", "search-repositories"]
    },
    "google-calendar": {
      "enabled": true,
      "tools": [
        "create-event",
        "search-events",
        "check-availability",
        "edit-event",
        "search-contacts",
        "get-current-user",
        "get-current-time",
        "list-calendars"
      ]
    },
    "google-workspace": {
      "enabled": true,
      "tools": ["search-files", "create-document"]
    },
    "slack": {
      "enabled": true,
      "tools": [
        "get-channels",
        "get-channel-history",
        "get-users",
        "get-emojis",
        "set-status",
        "search-messages"
      ]
    },
    "obsidian": {
      "enabled": true,
      "tools": [
        "getVaults",
        "searchNote",
        "createNote",
        "readNote",
        "openNote",
        "appendNote",
        "updateNote"
      ]
    },
    "apple-notes": {
      "enabled": true,
      "tools": ["create-note", "search-notes", "get-note-content", "update-note"]
    },
    "apple-reminders": {
      "enabled": true,
      "tools": [
        "create-reminder",
        "get-lists",
        "get-reminders",
        "get-locations",
        "get-completed-reminders",
        "update-reminder"
      ]
    },
    "kill-process": {
      "enabled": false,
      "_note": "Available but disabled by default — enabling lets the AI terminate arbitrary processes."
    },
    "arc": {
      "enabled": true,
      "tools": [
        "new-tab",
        "get-tabs",
        "select-tab",
        "get-spaces",
        "get-active-space",
        "search-history"
      ]
    },
    "downloads-manager": {
      "enabled": true,
      "tools": [
        "get-latest-download",
        "copy-latest-download",
        "open-latest-download",
        "show-latest-download"
      ]
    },
    "video-downloader": {
      "enabled": true,
      "tools": ["download-video", "extract-transcript"]
    },
    "base64": {
      "enabled": true,
      "tools": ["base64-encode", "base64-decode"]
    },
    "ccusage": {
      "enabled": false,
      "_note": "Disabled by request — Claude Code usage stats are not needed in RayBridge"
    },
    "music": {
      "enabled": false,
      "_note": "Available but disabled by default — enable if you want AI to control Apple Music"
    },
    "xcode": {
      "enabled": true,
      "tools": [
        "xcode-projects",
        "xcode-swift-package-resolved",
        "xcode-simulators",
        "xcode-simulator-applications",
        "xcode-releases"
      ],
      "_note": "Read-only Xcode inventory tools are enabled; simulator control and cache cleanup tools stay disabled by default."
    },
    "sips": {
      "enabled": false,
      "_note": "Available but disabled by default — image manipulation tools"
    },
    "media-converter": {
      "enabled": false,
      "_note": "Available but disabled by default — file conversion"
    },
    "svgl": {
      "enabled": true,
      "tools": ["get-svg-logo", "get-svg-component"]
    },
    "timers": {
      "enabled": false
    },
    "pomodoro": {
      "enabled": false
    },
    "mcp": {
      "enabled": false,
      "_note": "Meta MCP tool — enable only if you need AI to invoke other MCP servers through Raycast"
    }
  }
}
